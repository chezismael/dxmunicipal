const esc = s => String(s == null ? "" : s).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

let state = { ans: {}, txt: {}, notes: {}, hist: [], cur: "start", maxPct: 0, m50: false, m80: false };
let downloadsApi = null;

/* ---------- Persistencia (solo en este dispositivo) ---------- */
function persist() { try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); } catch (e) { /* sin almacenamiento */ } }
function restore() {
  try {
    const raw = localStorage.getItem(STORE_KEY);
    if (!raw) return null;
    const s = JSON.parse(raw);
    return s && s.ans ? s : null;
  } catch (e) { return null; }
}
function clearSaved() { try { localStorage.removeItem(STORE_KEY); } catch (e) { /* nada */ } }

/* ---------- Ayudas ---------- */
const ctx = id => contextFor(state.ans, id);
const optsOf = (q, A) => resolve(q.options, A || ctx(q.id)) || [];
const CHECK = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';

function progressInfo() {
  const route = buildRoute(state.ans, true);
  const total = routeSeconds(route);
  const idx = route.indexOf(state.cur);
  let before = 0;
  if (state.cur === "end") before = total;
  else if (idx > 0) {
    const seen = new Set();
    before = START_OVERHEAD;
    for (let i = 0; i < idx; i++) { before += QBYID[route[i]].sec; seen.add(QBYID[route[i]].part); }
    before += seen.size * PART_OVERHEAD;
  } else before = START_OVERHEAD;
  const pct = Math.min(1, before / total);
  state.maxPct = Math.max(state.maxPct || 0, pct);
  const parts = [];
  route.forEach(id => { const p = QBYID[id].part; if (!parts.includes(p)) parts.push(p); });
  const curPart = state.cur === "end" ? parts[parts.length - 1] : (QBYID[state.cur] || {}).part;
  return { route, total, remaining: Math.max(0, total - before), partIdx: parts.indexOf(curPart) + 1, partTotal: parts.length, partId: curPart, parts };
}

function renderTop() {
  const bar = $("#topbar");
  if (state.cur === "start" || state.cur === "review") { bar.hidden = true; return; }
  bar.hidden = false;
  const pi = progressInfo();
  $("#tb-title").textContent = state.cur === "end" ? "Cuestionario completo" : PBYID[pi.partId].title;
  $("#tb-part").textContent = state.cur === "end" ? "Gracias" : "Parte " + pi.partIdx + " de " + pi.partTotal;
  let t;
  if (state.cur === "end") t = "Listo";
  else if (state.cur === pi.route[pi.route.length - 1]) t = "Última pantalla";
  else if (pi.remaining < 75) t = "Falta menos de 1 min";
  else t = "Faltan unos " + Math.round(pi.remaining / 60) + " min";
  $("#tb-time").textContent = t;
  const pct = state.cur === "end" ? 100 : Math.round(state.maxPct * 100);
  $("#fill").style.width = pct + "%";
  $("#road").setAttribute("aria-valuenow", String(pct));
}

/* ---------- Navegación ---------- */
function go(id, back) {
  state.cur = id;
  if (id !== "start") persist();   // la pantalla de inicio no debe borrar el avance guardado
  if (id === "start") renderStart();
  else if (id === "end") renderEnd();
  else renderQuestion(QBYID[id]);
  renderTop();
  const bar = $("#actions");
  bar.hidden = (id === "start" || id === "end" || id === "review");
  if (id !== "start" && id !== "end") {
    $("#btn-next").textContent = (progressInfo().route.slice(-1)[0] === id) ? "Terminar" : "Siguiente";
  }
  renderNotes();
  window.scrollTo(0, 0);
  const h = document.querySelector("[data-focus]");
  if (h) h.focus({ preventScroll: true });
}

function next() {
  const q = QBYID[state.cur];
  if (!validate(q)) return;
  const route = buildRoute(state.ans, true);
  const i = route.indexOf(q.id);
  state.hist.push(q.id);
  go(route[i + 1] || "end");
}
function back() {
  if (state.hist.length) go(state.hist.pop(), true);
  else go("start", true);
}

/* ---------- Libreta de notas (una por parte) ---------- */
function renderNotes() {
  const aside = $("#notes"), fab = $("#notes-open");
  const q = QBYID[state.cur];
  if (!q) { aside.hidden = true; fab.hidden = true; aside.classList.remove("open"); return; }
  state.notes = state.notes || {};
  $("#nb-title").textContent = "Notas: " + PBYID[q.part].title;
