const QBYID = Object.fromEntries(Q.map(q => [q.id, q]));
const PBYID = Object.fromEntries(PARTS.map(p => [p.id, p]));
const PART_OVERHEAD = 5;   // segundos por parte (leer la transición)
const START_OVERHEAD = 20; // segundos de la pantalla de inicio

/* ---------- Motor de rutas ---------- */
function resolve(x, A) { return typeof x === "function" ? x(A) : x; }

/* Devuelve la lista de ids visibles en orden. Las respuestas ya dadas pesan;
   las que faltan se suponen típicas (solo para proyectar tiempo y avance). */
function buildRoute(ans, project) {
  const A = {};
  const route = [];
  for (const q of Q) {
    if (q.when && !q.when(A)) continue;
    route.push(q.id);
    let v = ans[q.id];
    if (v === undefined && project) v = q.typical;
    if (v !== undefined) A[q.id] = v;
  }
  return route;
}

function routeSeconds(route) {
  const parts = new Set();
  let s = START_OVERHEAD;
  for (const id of route) { s += QBYID[id].sec; parts.add(QBYID[id].part); }
  return s + parts.size * PART_OVERHEAD;
}

/* Contexto de respuestas visibles hasta una pregunta (para textos dinámicos) */
function contextFor(ans, upToId) {
  const A = {};
  for (const q of Q) {
    if (q.id === upToId) break;
    if (q.when && !q.when(A)) continue;
    if (ans[q.id] !== undefined) A[q.id] = ans[q.id];
  }
  return A;
}

