      h += '<div class="f" data-f="' + f.k + '"><label for="' + id + '">' + esc(f.label) + '</label><input class="in" id="' + id + '" type="' + type + '" data-field="' + f.k + '" placeholder="' + esc(f.ph || "") + '" value="' + esc(val) + '"' + extra + im + '><div class="ferr" hidden></div></div>';
    }
  });
  return h;
}

/* ---------- Validación ---------- */
function showError(msg) { const e = $("#err"); if (e) { e.textContent = msg; e.hidden = false; e.scrollIntoView({ block: "center", behavior: "smooth" }); } }
function hideError() { const e = $("#err"); if (e) e.hidden = true; }

function validate(q) {
  if (q.type === "fields") {
    const A = ctx(q.id);
    const fields = resolve(q.fields, A);
    const cur = state.ans[q.id] || {};
    let first = null;
    fields.forEach(f => {
      const wrap = document.querySelector('[data-f="' + f.k + '"]');
      const er = wrap && wrap.querySelector(".ferr");
      const input = wrap && wrap.querySelector("input,textarea");
      const val = (cur[f.k] || "").trim();
      let msg = "";
      if (f.req && !val) msg = f.kind === "radio" ? "Elija una opción." : "Complete este campo.";
      else if (f.kind === "radio" && (f.options.find(x => x.v === cur[f.k]) || {}).other && !(cur[f.k + "_otro"] || "").trim()) msg = "Escriba cuál en el espacio de «Otra».";
      else if (f.kind === "email" && val && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) msg = "Escriba un correo válido, por ejemplo nombre@municipio.gob.mx.";
      if (er) { er.textContent = msg; er.hidden = !msg; }
      if (input && f.kind !== "radio") input.setAttribute("aria-invalid", msg ? "true" : "false");
      if (msg && !first) first = wrap;
    });
    if (first) { first.scrollIntoView({ block: "center", behavior: "smooth" }); const i = first.querySelector("input,textarea"); if (i) i.focus({ preventScroll: true }); return false; }
    return true;
  }
  if (q.type === "groups") {
    const cur = state.ans[q.id] || {};
    for (const g of resolve(q.groups, ctx(q.id))) {
      const sel = cur[g.k] || [];
      if (!sel.length) { showError("Marque al menos una opción en «" + g.title + "». Si no lo sabe, marque «No sé»."); const fs = document.querySelector('[data-g="' + g.k + '"]'); if (fs) fs.scrollIntoView({ block: "start", behavior: "smooth" }); return false; }
      for (const v of sel) {
        const ov = g.options.find(x => x.v === v);
        if (ov && ov.other && !(((state.txt[q.id] || {})[g.k + ":" + v]) || "").trim()) {
          showError("Escriba el dato en el espacio de «" + ov.l + "» en la sección «" + g.title + "»."); const f = document.querySelector('[data-other="' + v + '"][data-gk="' + g.k + '"]'); if (f) f.focus(); return false;
        }
      }
    }
    return true;
  }
  const sel = selectedOf(q);
  const o = optsOf(q);
  const hasDk = o.some(x => x.dk);
  if (!q.optional && (!sel.length || (q.type === "select" && !state.ans[q.id]))) {
    showError(q.type === "multi" ? "Marque al menos una opción para continuar." + (hasDk ? " Si no lo sabe, marque «No sé»." : "")
      : q.type === "select" ? "Elija un año para continuar. Si no lo sabe, elija «No sé»."
      : "Elija una opción para continuar." + (hasDk ? " Si no lo sabe, elija «No sé»." : ""));
    return false;
  }
  for (const v of sel) {
    const ov = o.find(x => x.v === v);
    if (ov && ov.other) {
      const t = ((state.txt[q.id] || {})[v] || "").trim();
      if (!t) { showError("Escriba el dato en el espacio de «" + ov.l + "»."); const f = document.querySelector('[data-other="' + v + '"]'); if (f) f.focus(); return false; }
    }
  }
  return true;
}

/* ---------- Pantalla final y exportación ---------- */
function csvCell(s) { return '"' + String(s == null ? "" : s).replace(/"/g, '""') + '"'; }
function buildCsv() {
  const route = buildRoute(state.ans, false);
  const notes = state.notes || {};
  const rows = [["id", "parte", "pregunta", "respuesta", "detalle_otro"]];
  const seen = {};   // parte -> ids de preguntas recorridas
  const flushNote = p => {
    const n = (notes[p] || "").trim();
    if (n) rows.push(["NOTA." + p, PBYID[p].title, "NOTA de la parte (preguntas " + (seen[p] || []).join(", ") + ")", n, ""]);
  };
  let prev = null;
  route.forEach(id => {
    const q = QBYID[id], A = ctx(id), v = state.ans[id];
    if (prev && prev !== q.part) flushNote(prev);
    prev = q.part; (seen[q.part] = seen[q.part] || []).push(id);
    const title = resolve(q.title, A);
    const part = PBYID[q.part].title;
    if (q.type === "fields") {
      const fl = resolve(q.fields, A), cur = v || {};
      fl.forEach(f => {
        let val = cur[f.k] || "";
        let det = "";
        if (f.kind === "radio") { const oo = f.options.find(x => x.v === val); if (oo && oo.other) det = cur[f.k + "_otro"] || ""; val = oo ? oo.l : val; }
        rows.push([id + "." + f.k, part, f.label, val, det]);
      });
    } else if (q.type === "groups") {
      const cur = v || {};
      resolve(q.groups, A).forEach(g => {
        const sel = cur[g.k] || [];
        const labels = sel.map(x => { const oo = g.options.find(y => y.v === x); return oo ? oo.l : x; });
        const det = sel.map(x => (state.txt[id] || {})[g.k + ":" + x]).filter(Boolean).join(" | ");
        rows.push([id + "." + g.k, part, title + " (sección " + g.title + ")", labels.join(" | "), det]);
      });
    } else {
      const o = optsOf(q, A);
      const sel = selectedOf(q);
      const labels = sel.map(x => { const oo = o.find(y => y.v === x); return oo ? oo.l : x; });
      const det = sel.map(x => (state.txt[id] || {})[x]).filter(Boolean).join(" | ");
      rows.push([id, part, title, labels.join(" | "), det]);
    }
  });
  if (prev) flushNote(prev);
  // notas de partes que ya no están en la ruta actual (por ejemplo, si cambió una respuesta anterior)
  PARTS.forEach(p => { if (!(p.id in seen) && (notes[p.id] || "").trim()) rows.push(["NOTA." + p.id, p.title, "NOTA de una parte fuera de la ruta actual", notes[p.id].trim(), ""]); });
  return "\uFEFF" + rows.map(r => r.map(csvCell).join(",")).join("\r\n");
}

function renderEnd() {
  const none = !hasInfo(state.ans.G1 ? { G1: state.ans.G1 } : {});
  const msg = none
