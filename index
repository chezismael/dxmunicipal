    '<p>El equipo revisará sus respuestas y, si usted lo indicó, se pondrá en contacto para dar seguimiento.</p>' +
    (PROTOTYPE ? '<div class="banner">Versión de prueba. Sus respuestas no se enviaron a nadie. Puede guardar una copia para revisarlas.</div>' : "") +
    '<div class="stack">' +
    '<button class="btn primary block" id="btn-download"' + (downloadsApi ? "" : " hidden") + ">Descargar mis respuestas (.csv)</button>" +
    '<button class="btn block" id="btn-copy">Copiar mis respuestas</button>' +
    '<button class="btn quiet block" id="btn-review">Revisar o corregir mis respuestas</button>' +
    '<button class="btn quiet block" id="btn-new">Empezar un cuestionario nuevo</button></div>' +
    '<p class="status" id="status" role="status" aria-live="polite"></p>';
}

