<header id="topbar" hidden>
  <div class="tb-in">
    <div class="tb-top"><div class="tb-title" id="tb-title"></div><button class="notes-fab" id="notes-open" type="button" aria-controls="notes" aria-expanded="false" hidden>Notas</button></div>
    <div class="tb-meta"><span id="tb-part"></span><span id="tb-time"></span></div>
    <div class="road" id="road" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Avance del cuestionario"><div class="road-fill" id="fill"></div></div>
  </div>
</header>
<div id="layout">
<main id="screen"></main>
<aside id="notes" aria-label="Libreta de notas" hidden>
  <div class="nb-head"><h2 id="nb-title">Notas</h2><button class="btn quiet nb-close" id="notes-close" type="button">Cerrar</button></div>
  <p class="hint" id="nb-hint"></p>
  <label class="sr" for="nb-text">Notas de esta parte</label>
