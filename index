/* ---------- Ayudas para condiciones ---------- */
const has = (A, id, v) => Array.isArray(A[id]) && A[id].includes(v);
const anyOf = (A, id, vs) => Array.isArray(A[id]) && A[id].some(x => vs.includes(x));
const isOwn = A => has(A, "G1", "own");
const isRecv = A => has(A, "G1", "recv");
const hasInfo = A => isOwn(A) || isRecv(A);
const hasTotals = A => has(A, "D1", "totales");
const hasDims = A => Array.isArray(A.D1) && A.D1.some(v => v !== "totales");
const iphUsed = A => ["siempre", "casi", "aveces"].includes(A.R1);
const digitalStorage = A => anyOf(A, "S1", ["pcpers", "pcinst", "nube", "externo", "otrosis"]);
const ownWord = A => (isOwn(A) ? "own" : "recv");

