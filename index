/* ---------- Pregunta con secciones (una lista de opciones por sección) ---------- */
function groupsHTML(q, A) {
  return resolve(q.groups, A).map(g =>
    '<fieldset class="grp" data-g="' + g.k + '"><legend class="grp-t">' + esc(g.title) + "</legend>" +
    g.options.map(o => {
      const txt = ((state.txt[q.id] || {})[g.k + ":" + o.v]) || "";
      return '<div class="optw' + (o.dk ? " dkw" : "") + '" data-gw="' + g.k + '" data-ow="' + esc(o.v) + '">' +
        '<label class="opt check' + (o.dk ? " dk" : "") + '"><input type="checkbox" value="' + esc(o.v) + '" data-gq="' + q.id + '" data-gk="' + g.k + '"><span class="mark">' + CHECK + '</span><span class="lbl">' + esc(o.l) + "</span></label>" +
        (o.other ? '<div class="other-row" hidden><input class="in" type="text" data-other="' + esc(o.v) + '" data-gq="' + q.id + '" data-gk="' + g.k + '" placeholder="' + esc(o.ph || "Escriba aquí") + '" value="' + esc(txt) + '" aria-label="' + esc(g.title + ": " + o.l) + '"></div>' : "") +
        "</div>";
    }).join("") + "</fieldset>").join("");
}
function syncGroups(q) {
  const cur = state.ans[q.id] || {};
  document.querySelectorAll("[data-gw]").forEach(w => {
    const gk = w.getAttribute("data-gw"), v = w.getAttribute("data-ow");
    const on = (cur[gk] || []).includes(v);
    w.querySelector("input[type=checkbox]").checked = on;
    w.querySelector(".opt").classList.toggle("sel", on);
    const r = w.querySelector(".other-row"); if (r) r.hidden = !on;
  });
}
function onGroupChange(input) {
  const q = QBYID[input.getAttribute("data-gq")], gk = input.getAttribute("data-gk"), v = input.value;
  const g = resolve(q.groups, ctx(q.id)).find(x => x.k === gk);
  const o = g.options.find(x => x.v === v);
  const ans = state.ans[q.id] = state.ans[q.id] || {};
  let cur = (ans[gk] || []).slice();
  if (input.checked) {
    if (o.ex) cur = [v];
    else { const exv = g.options.filter(x => x.ex).map(x => x.v); cur = cur.filter(x => !exv.includes(x)); cur.push(v); }
  } else cur = cur.filter(x => x !== v);
  ans[gk] = cur;
  const t = state.txt[q.id] || {};
  Object.keys(t).forEach(k => { if (k.indexOf(gk + ":") === 0 && !cur.includes(k.slice(gk.length + 1))) delete t[k]; });
  hideError(); syncGroups(q); persist(); renderTop();
  if (o.other && input.checked) { const f = document.querySelector('[data-other="' + v + '"][data-gk="' + gk + '"]'); if (f) f.focus(); }
}

function svgIcon(g) { return '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' + GLYPHS[g] + "</svg>"; }
function optionHTML(q, o, anyIc) {
  const kind = q.type === "multi" ? "check" : "radio";
  const type = q.type === "multi" ? "checkbox" : "radio";
  const txt = ((state.txt[q.id] || {})[o.v]) || "";
  return '<div class="optw' + (o.dk ? " dkw" : "") + '" data-ow="' + esc(o.v) + '">' +
    '<label class="opt ' + kind + (o.dk ? " dk" : "") + '"><input type="' + type + '" name="' + q.id + '" value="' + esc(o.v) + '" data-qid="' + q.id + '">' +
    '<span class="mark">' + (kind === "check" ? CHECK : "") + "</span>" + (anyIc ? '<span class="ic" aria-hidden="true">' + (o.ic || []).map(svgIcon).join("") + "</span>" : "") + '<span class="lbl">' + esc(o.l) + "</span></label>" +
    (o.other ? '<div class="other-row" hidden><input class="in" type="text" data-other="' + esc(o.v) + '" data-qid="' + q.id + '" placeholder="' + esc(o.ph || "Escriba aquí") + '" value="' + esc(txt) + '" aria-label="' + esc(o.l) + '"></div>' : "") +
    "</div>";
}

function selectedOf(q) {
  const v = state.ans[q.id];
  if (q.type === "multi") return Array.isArray(v) ? v : [];
  return v === undefined ? [] : [v];
}

function syncOptions(q) {
  const sel = selectedOf(q);
  const full = q.max && sel.length >= q.max;
  document.querySelectorAll('.optw').forEach(w => {
    const v = w.getAttribute("data-ow");
    const input = w.querySelector("input[type=checkbox],input[type=radio]");
    const label = w.querySelector(".opt");
    const on = sel.includes(v);
    input.checked = on;
    label.classList.toggle("sel", on);
    const off = !!(full && !on && q.type === "multi");
    input.disabled = off; label.classList.toggle("off", off);
    const row = w.querySelector(".other-row");
    if (row) row.hidden = !on;
  });
  const c = $("#count");
  if (c) c.textContent = "Ha elegido " + sel.length + " de " + q.max + ".";
}

function onOptionChange(input) {
  const q = QBYID[input.getAttribute("data-qid")];
  const v = input.value;
  const o = optsOf(q).find(x => x.v === v);
  if (q.type === "multi") {
    let cur = selectedOf(q).slice();
    if (input.checked) {
      if (o.ex) { cur = [v]; }
      else {
        const exv = optsOf(q).filter(x => x.ex).map(x => x.v);
        cur = cur.filter(x => !exv.includes(x));
        cur.push(v);
      }
    } else cur = cur.filter(x => x !== v);
    state.ans[q.id] = cur;
    // limpiar textos de opciones que ya no están marcadas
    const t = state.txt[q.id] || {};
    Object.keys(t).forEach(k => { if (!cur.includes(k)) delete t[k]; });
  } else {
    state.ans[q.id] = v;
    const t = state.txt[q.id] || {};
    Object.keys(t).forEach(k => { if (k !== v) delete t[k]; });
  }
  hideError();
  syncOptions(q);
  persist();
  if (o && o.other && input.checked) {
    const f = document.querySelector('[data-other="' + v + '"]');
    if (f) f.focus();
  }
  renderTop();
}

/* ---------- Campos de formulario ---------- */
function fieldsHTML(q, A) {
