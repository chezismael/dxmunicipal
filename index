          (o.other ? '<div class="other-row"' + (val === o.v ? "" : " hidden") + '><input class="in" type="text" data-field="' + f.k + '_otro" placeholder="' + esc(o.ph || "Escriba cuál") + '" value="' + esc(cur[f.k + "_otro"] || "") + '" aria-label="' + esc(o.l) + '"></div>' : "") +
