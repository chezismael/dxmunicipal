  "C. Registra solo totales": { I1: { municipio: "x", inst: "x", tipo: "policia" }, G1: ["own"], D1: ["totales"], R1: "nunca", R3: ["ninguno"], S1: ["papel"] },
  "D. Registra en papel y captura en Excel (policía)": { I1: { municipio: "x", inst: "x", tipo: "policia" }, G1: ["own"], R1: "siempre", R3: ["propioEst"], R5: "papel", R7: ["hoja"], S1: ["pcinst"], X6: "no" },
  "D2. Igual que D, pero tránsito (sin IPH)": { I1: { municipio: "x", inst: "x", tipo: "transito" }, G1: ["own"], R3: ["propioEst"], R5: "papel", R7: ["hoja"], S1: ["pcinst"], X6: "no" },
  "E. Máximo: registra y recibe, todo activo": { I1: { municipio: "x", inst: "x", tipo: "policia" }, G1: ["own", "recv"], D1: ["detalle"], C1: ["lesionadas", "fallecidas", "danos"], N2: "aveces", R1: "siempre", R2: ["papel", "escaneo", "captura"], R3: ["propioEst", "propioLib", "mensajes", "central"], R5: "ambos", R7: ["hoja", "libro"], X1: ["fiscalia", "c5"], X4: "si", X6: "regular", U1: ["tendencias", "lugares"] }
};
function fillScenario(over) {
  const ans = {};
  for (let i = 0; i < 6; i++) buildRoute(ans, true).forEach(id => { if (ans[id] === undefined) ans[id] = over[id] !== undefined ? over[id] : QBYID[id].typical; });
  Object.keys(over).forEach(k => { ans[k] = over[k]; });
  return ans;
}
function renderReview() {
  state.cur = "review";
  $("#topbar").hidden = true; $("#actions").hidden = true;
  $("#notes").hidden = true; $("#notes-open").hidden = true;
  const rows = Object.entries(SCENARIOS).map(([n, o]) => {
    const r = buildRoute(fillScenario(o), false);
    return "<tr><td>" + esc(n) + "</td><td>" + r.length + "</td><td>" + (routeSeconds(r) / 60).toFixed(1) + "</td></tr>";
  }).join("");
  const A0 = { G1: ["own"] };
  const list = PARTS.map(p => "<h2>" + esc(p.title) + "</h2>" + Q.filter(q => q.part === p.id).map(q =>
    '<div class="rv-q"><span class="id">' + q.id + "</span>" + esc(resolve(q.title, A0)) +
    '<div class="meta">' + ({ fields: "campos", single: "una opción", select: "lista", multi: "varias opciones", groups: "secciones con varias opciones" }[q.type]) + ", unos " + q.sec + " s</div>" +
    '<div class="rule">Regla. ' + esc(q.rule) + "</div></div>").join("")).join("");
  $("#screen").innerHTML = '<div class="rv"><p><a href="#" id="rv-back">Volver al cuestionario</a></p><h1>Vista de revisión</h1>' +
    "<p>Reglas de salto y tiempos de cada pregunta. Los tiempos son supuestos de trabajo (segundos por pantalla más lectura de transiciones) y deben confirmarse con una prueba piloto.</p>" +
    '<h2>Recorridos de ejemplo</h2><div class="scroll"><table><thead><tr><th>Recorrido</th><th>Pantallas</th><th>Minutos</th></tr></thead><tbody>' + rows + "</tbody></table></div>" + list + "</div>";
  window.scrollTo(0, 0);
}

/* ---------- Eventos ---------- */
document.addEventListener("click", e => {
  const id = e.target.id;
  if (id === "btn-start") { state = { ans: {}, txt: {}, notes: {}, hist: [], cur: "start", maxPct: 0, m50: false, m80: false }; go("I1"); }
  else if (id === "btn-resume") { const s = restore(); if (s) { state = s; go(state.cur); } }
  else if (id === "btn-restart") { clearSaved(); state = { ans: {}, txt: {}, notes: {}, hist: [], cur: "start", maxPct: 0, m50: false, m80: false }; go("I1"); }
  else if (id === "btn-next") next();
  else if (id === "btn-back") back();
  else if (id === "btn-download") doDownload();
  else if (id === "btn-copy") doCopy();
  else if (id === "btn-review") { const route = buildRoute(state.ans, false); state.hist = route.slice(0, -1); go(route[route.length - 1]); }
  else if (id === "btn-new") { clearSaved(); state = { ans: {}, txt: {}, notes: {}, hist: [], cur: "start", maxPct: 0, m50: false, m80: false }; go("start"); }
  else if (id === "notes-open") toggleNotes(!$("#notes").classList.contains("open"));
  else if (id === "notes-close") toggleNotes(false);
  else if (id === "notes-copy") copyNotes();
  else if (id === "notes-csv") downloadFromNotes();
  else if (id === "rv-back") { e.preventDefault(); location.hash = ""; }
});

document.addEventListener("change", e => {
  const t = e.target;
  if (t.matches("input[data-gk][type=checkbox]")) onGroupChange(t);
  else if (t.matches("input[data-qid][type=checkbox],input[data-qid][type=radio]")) onOptionChange(t);
  else if (t.matches("select[data-qid]")) { state.ans[t.getAttribute("data-qid")] = t.value; hideError(); persist(); renderTop(); }
  else if (t.matches("input[data-fradio]")) {
    const q = QBYID[state.cur]; const cur = state.ans[q.id] || (state.ans[q.id] = {}); cur[t.getAttribute("data-fradio")] = t.value;
    t.closest("fieldset").querySelectorAll(".opt").forEach(l => l.classList.toggle("sel", l.querySelector("input").checked));
    const er = t.closest("fieldset").querySelector(".ferr"); if (er) er.hidden = true;
    t.closest("fieldset").querySelectorAll(".optw").forEach(w => { const r = w.querySelector(".other-row"); if (r) r.hidden = !w.querySelector("input[type=radio]").checked; });
    const op = t.closest(".optw").querySelector(".other-row input"); if (op && !op.closest(".other-row").hidden) op.focus();
    persist();
  }
});

document.addEventListener("input", e => {
  const t = e.target;
  if (t.id === "nb-text") {
    state.notes = state.notes || {};
    state.notes[t.dataset.part] = t.value;
    persist();
  } else if (t.matches("input[data-other][data-gk]")) {
    const qid = t.getAttribute("data-gq");
    (state.txt[qid] = state.txt[qid] || {})[t.getAttribute("data-gk") + ":" + t.getAttribute("data-other")] = t.value;
    hideError(); persist();
  } else if (t.matches("input[data-other]")) {
    const qid = t.getAttribute("data-qid");
    (state.txt[qid] = state.txt[qid] || {})[t.getAttribute("data-other")] = t.value;
    hideError(); persist();
  } else if (t.matches("[data-field]")) {
    const q = QBYID[state.cur]; const cur = state.ans[q.id] || (state.ans[q.id] = {});
    cur[t.getAttribute("data-field")] = t.value;
    t.setAttribute("aria-invalid", "false");
    const er = t.parentElement.querySelector(".ferr"); if (er) er.hidden = true;
    persist();
  }
});

document.addEventListener("keydown", e => {
  if (e.key === "Enter" && e.target.matches("input.in[type=text],input.in[type=email],input.in[type=tel]") && !e.target.matches("[data-other]")) { e.preventDefault(); next(); }
});

function route() {
  if (location.hash === "#revision") { renderReview(); return; }
  if (state.cur === "review") { state.cur = "start"; }
  if (state.cur === "start") go("start");
}
window.addEventListener("hashchange", () => { if (location.hash === "#revision") renderReview(); else { const s = restore(); state.cur = "start"; go("start"); } });

/* ---------- Arranque ---------- */
(function init() {
  const dl = document.getElementById("municipios");
  dl.innerHTML = MUNICIPIOS.map(m => '<option value="' + esc(m) + '"></option>').join("");
  if (location.hash === "#revision") renderReview(); else go("start");
  // Fuera de Claude (archivo descargado o publicado en otro sitio): descarga directa con el navegador
  if (!(window.claude && window.claude.use)) {
    downloadsApi = { save: async ({ filename, data }) => {
      const url = URL.createObjectURL(new Blob([data], { type: "text/csv;charset=utf-8" }));
      const a = document.createElement("a"); a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 2000);
    } };
    const nb = document.getElementById("notes-csv"); if (nb) nb.hidden = false;
  }
  try {
    if (window.claude && window.claude.use) window.claude.use("downloads").then(d => { downloadsApi = d; const b = document.getElementById("btn-download"); if (b && d) b.hidden = false; const nb = document.getElementById("notes-csv"); if (nb && d) nb.hidden = false; }).catch(() => {});
  } catch (e) { /* sin descargas */ }
})();

</script>
</body>
