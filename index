/* ---------- Pantalla de pregunta ---------- */
function transitionHTML(q, pi) {
  const first = pi.route.find(id => QBYID[id].part === q.part);
  if (first !== q.id) return "";
  let pre = "";
  if (state.maxPct >= 0.5 && !state.m50) { pre = "Ya va por la mitad. "; state.m50 = true; }
  else if (state.maxPct >= 0.8 && !state.m80) { pre = "Casi termina. "; state.m80 = true; }
  return '<div class="trans">' + esc(pre + PBYID[q.part].intro) + "</div>";
}

function renderQuestion(q) {
  const A = ctx(q.id);
  const pi = progressInfo();
  const title = resolve(q.title, A), help = resolve(q.help, A);
  let body = "";
  if (q.type === "fields") body = fieldsHTML(q, A);
  else if (q.type === "groups") body = groupsHTML(q, A);
  else if (q.type === "select") {
    const cur = state.ans[q.id] || "";
    body = '<div class="f"><label class="sr" for="sel">' + esc(title) + '</label><select class="in" id="sel" data-qid="' + q.id + '"><option value="">' + esc(q.ph || "Elija una opción") + "</option>" +
      optsOf(q, A).map(o => '<option value="' + esc(o.v) + '"' + (cur === o.v ? " selected" : "") + ">" + esc(o.l) + "</option>").join("") + "</select></div>";
  } else {
    const os = optsOf(q, A), anyIc = os.some(o => o.ic), wide = os.some(o => o.ic && o.ic.length > 1);
    body = '<fieldset' + (anyIc ? ' style="--icw:' + (wide ? 56 : 28) + 'px"' : "") + '><legend class="sr">' + esc(title) + "</legend>" + os.map(o => optionHTML(q, o, anyIc)).join("") + "</fieldset>" +
      (q.max ? '<p class="count" id="count" aria-live="polite"></p>' : "");
