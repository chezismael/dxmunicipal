  <button class="btn primary nb-copy" id="notes-csv" type="button" hidden>Descargar CSV con notas</button>
  <button class="btn quiet nb-copy" id="notes-copy" type="button">Copiar CSV con notas</button>
  <p class="status" id="nb-status" role="status" aria-live="polite"></p>
</aside>
</div>
<datalist id="municipios"></datalist>
<footer class="bar" id="actions" hidden>
  <div class="bar-in">
    <button class="btn back" id="btn-back" type="button">Atrás</button>
    <button class="btn primary" id="btn-next" type="button">Siguiente</button>
  </div>
</footer>
