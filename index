<!DOCTYPE html>
<html lang="es-MX">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Diagnóstico municipal de registros de siniestros de tránsito</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  --bg: #F4F6F5;
  --surface: #FFFFFF;
  --ink: #16212A;
  --muted: #4E5E68;
  --line: #CBD5DA;
  --accent: #F2B705;
  --accent-soft: #FFF1BD;
  --on-accent: #16212A;
  --primary: #16212A;
  --on-primary: #FFFFFF;
  --focus: #1D5FD1;
  --error: #B3261E;
  --error-soft: #FCE9E7;
  --track: #D9E1E4;
  --dash: #FFFFFF;
  --note: #E9EFF1;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #10171C; --surface: #18222A; --ink: #EAF0F3; --muted: #A9B7C0; --line: #33444F;
    --accent: #F2B705; --accent-soft: #3A3010; --on-accent: #10171C;
    --primary: #F2B705; --on-primary: #10171C;
    --focus: #8DB5FF; --error: #FF9C94; --error-soft: #3A1E1C;
    --track: #2A3943; --dash: #10171C; --note: #1F2B33;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #10171C; --surface: #18222A; --ink: #EAF0F3; --muted: #A9B7C0; --line: #33444F;
  --accent: #F2B705; --accent-soft: #3A3010; --on-accent: #10171C;
  --primary: #F2B705; --on-primary: #10171C;
  --focus: #8DB5FF; --error: #FF9C94; --error-soft: #3A1E1C;
  --track: #2A3943; --dash: #10171C; --note: #1F2B33;
  color-scheme: dark;
}
html { scroll-padding-top: env(safe-area-inset-top, 0px); -webkit-text-size-adjust: 100%; }
*, *::before, *::after { box-sizing: inherit; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: "Atkinson Hyperlegible", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 17px;
  line-height: 1.5;
}
body::before {
  content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px);
  background: var(--bg); z-index: 10;
}
button, input, select, textarea { font: inherit; color: inherit; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* ----- Barra superior y avance ----- */
#topbar {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 9;
  background: var(--bg); border-bottom: 1px solid var(--line);
  padding: 10px 16px 12px;
}
.tb-in { max-width: 620px; margin: 0 auto; }
.tb-title { font-weight: 700; font-size: 15.5px; line-height: 1.3; }
.tb-meta { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; color: var(--muted); margin-top: 2px; }
.road { position: relative; height: 14px; border-radius: 7px; background: var(--track); overflow: hidden; margin-top: 8px; }
.road::before {
  content: ""; position: absolute; left: 0; right: 0; top: 6px; height: 2px;
  background-image: repeating-linear-gradient(90deg, var(--dash) 0 8px, transparent 8px 16px);
}
.road-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--accent); border-radius: 7px; transition: width .4s ease; }
.road-fill::after {
  content: ""; position: absolute; left: 0; right: 0; top: 6px; height: 2px;
  background-image: repeating-linear-gradient(90deg, var(--on-accent) 0 8px, transparent 8px 16px);
}

/* ----- Contenido ----- */
main { max-width: 620px; margin: 0 auto; padding: 22px 16px 150px; }
.banner {
  background: var(--note); border-radius: 10px; padding: 10px 14px; font-size: 14.5px; color: var(--muted); margin-bottom: 22px;
}
.banner a { color: var(--ink); font-weight: 700; }
h1 { font-size: 30px; line-height: 1.15; margin: 0 0 14px; letter-spacing: -0.01em; }
.lead { font-size: 18px; margin: 0 0 20px; }
.facts { margin: 0 0 20px; padding: 0; }
.facts div { padding: 12px 0; border-top: 1px solid var(--line); }
.facts div:last-child { border-bottom: 1px solid var(--line); }
.facts dt { font-weight: 700; margin: 0; }
.facts dd { margin: 2px 0 0; color: var(--muted); }
.defn { background: var(--surface); border: 2px solid var(--line); border-radius: 12px; padding: 14px 16px; margin: 0 0 24px; }
.defn b { display: block; margin-bottom: 4px; }

.trans {
  background: var(--accent-soft); border-left: 6px solid var(--accent);
  border-radius: 8px; padding: 12px 14px; margin: 0 0 22px; font-size: 16px;
}
[data-focus] { outline: none; }
.qt { font-size: 23px; line-height: 1.28; margin: 0 0 8px; font-weight: 700; outline: none; }
.help { color: var(--muted); font-size: 16px; margin: 0 0 18px; }
.err {
  background: var(--error-soft); color: var(--error); border-radius: 10px; padding: 10px 14px;
  margin: 0 0 14px; font-weight: 700; font-size: 15.5px;
}
.count { color: var(--muted); font-size: 15px; margin: 4px 0 0; }
fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }

/* ----- Opciones ----- */
.optw { margin-bottom: 10px; }
.opt {
  position: relative; display: flex; gap: 14px; align-items: flex-start;
  min-height: 56px; padding: 14px 16px; background: var(--surface);
  border: 2px solid var(--line); border-radius: 12px; cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.opt input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
.mark {
  flex: none; width: 26px; height: 26px; margin-top: 1px; border: 2px solid var(--muted);
  background: var(--surface); display: grid; place-items: center;
}
.opt.radio .mark { border-radius: 50%; }
.opt.check .mark { border-radius: 7px; }
.mark svg { width: 16px; height: 16px; opacity: 0; }
.mark svg path { stroke: var(--bg); }
.opt.radio .mark::after { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--bg); opacity: 0; }
.opt.sel { border-color: var(--ink); background: var(--accent-soft); }
.opt.sel .mark { background: var(--ink); border-color: var(--ink); }
.opt.sel .mark svg, .opt.sel.radio .mark::after { opacity: 1; }
.opt input:focus-visible + .mark { outline: 3px solid var(--focus); outline-offset: 3px; }
.opt.dk { border-style: dashed; background: transparent; color: var(--muted); }
.opt.dk.sel { color: var(--ink); background: var(--accent-soft); }
.optw.dkw { margin-top: 18px; }
.opt.off { opacity: .5; cursor: not-allowed; }
.opt.off input { cursor: not-allowed; }
.ic { display: flex; align-items: center; gap: 2px; flex: none; min-width: var(--icw, 24px); height: 26px; margin-top: 1px; color: var(--muted); }
.opt.sel .ic { color: var(--ink); }
.lbl { padding-top: 1px; }
.other-row { padding: 8px 0 2px 0; }

.grp { margin: 0 0 28px; }
.grp-t { display: block; width: 100%; font-weight: 700; font-size: 19px; padding: 0 0 6px; margin: 0 0 12px; border-bottom: 3px solid var(--accent); }

/* ----- Campos ----- */
.f { margin: 0 0 18px; }
.f > label, .f > legend { display: block; font-weight: 700; margin: 0 0 6px; padding: 0; }
.in, select.in, textarea.in {
  width: 100%; min-height: 54px; padding: 12px 14px; font-size: 17px;
  background: var(--surface); border: 2px solid var(--line); border-radius: 10px;
}
textarea.in { min-height: 96px; resize: vertical; }
.in:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-color: var(--ink); }
.in[aria-invalid="true"] { border-color: var(--error); }
.hint { color: var(--muted); font-size: 14.5px; margin: 5px 0 0; }
.ferr { color: var(--error); font-weight: 700; font-size: 15px; margin: 6px 0 0; }

/* ----- Botones ----- */
.btn {
  min-height: 54px; padding: 0 22px; border-radius: 12px; border: 2px solid var(--primary);
  font-weight: 700; font-size: 17px; cursor: pointer; background: transparent; color: var(--ink);
}
.btn.primary { background: var(--primary); color: var(--on-primary); }
.btn.block { width: 100%; }
.btn:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
.btn[disabled] { opacity: .5; cursor: default; }
.btn.quiet { border-color: var(--line); }
.stack { display: grid; gap: 12px; }
.bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 8;
  background: var(--surface); border-top: 1px solid var(--line);
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
}
.bar-in { max-width: 620px; margin: 0 auto; display: flex; gap: 12px; }
.bar .btn.primary { flex: 1; }
.bar .btn.back { flex: 0 0 auto; min-width: 104px; border-color: var(--line); }
.status { color: var(--muted); font-size: 15px; margin: 4px 0 0; min-height: 1.5em; }

/* ----- Fin ----- */
.done-mark {
  width: 56px; height: 56px; border-radius: 50%; background: var(--accent); color: var(--on-accent);
  display: grid; place-items: center; margin-bottom: 16px;
}
.done-mark svg { width: 30px; height: 30px; }

/* ----- Vista de revisión ----- */
.rv h2 { font-size: 20px; margin: 30px 0 8px; }
.rv table { width: 100%; border-collapse: collapse; font-size: 15px; }
.rv th, .rv td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--line); vertical-align: top; }
.rv .scroll { overflow-x: auto; }
.rv-q { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; margin: 0 0 8px; }
.rv-q .id { display: inline-block; background: var(--ink); color: var(--bg); border-radius: 6px; padding: 0 7px; font-weight: 700; font-size: 14px; margin-right: 6px; }
.rv-q .rule { color: var(--muted); font-size: 14.5px; margin-top: 4px; }
.rv-q .meta { color: var(--muted); font-size: 13.5px; }


[hidden] { display: none !important; }
#layout { max-width: 1000px; margin: 0 auto; }
#notes { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
.nb-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 4px; }
.nb-head h2 { font-size: 17px; line-height: 1.3; margin: 0; }
.nb-close { display: none; min-height: 40px; padding: 0 14px; font-size: 15px; }
#nb-hint { margin: 0 0 10px; }
.nb-text { min-height: 240px; font-size: 16px; }
.tb-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.notes-fab {
  flex: none; min-height: 36px; padding: 0 14px; border-radius: 18px; border: 2px solid var(--primary);
  background: var(--surface); color: var(--ink); font-weight: 700; font-size: 15px; cursor: pointer;
}
.notes-fab:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
@media (max-width: 899px) {
  #notes {
    position: fixed; left: 0; right: 0; bottom: calc(84px + env(safe-area-inset-bottom, 0px)); z-index: 9;
    display: none; max-height: 55vh; overflow-y: auto; margin: 0; border-radius: 14px 14px 0 0;
    box-shadow: 0 -4px 18px rgba(0,0,0,.14);
  }
  #notes.open { display: block; }
  #notes.open .nb-text { min-height: 150px; }
  .nb-close { display: inline-flex; }
}
@media (min-width: 900px) {
  #layout { display: grid; grid-template-columns: minmax(0, 620px) 300px; justify-content: center; gap: 28px; align-items: start; }
  #layout main { margin: 0; }
  #notes { position: sticky; top: 130px; display: block; }
  .notes-fab { display: none !important; }
}

@media (prefers-reduced-motion: reduce) { .road-fill { transition: none; } }
@media (min-width: 700px) { main { padding-top: 34px; } .qt { font-size: 26px; } h1 { font-size: 36px; } }

</style>
</head>
